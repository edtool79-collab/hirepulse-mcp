        300
      ],
      "parameters": {
        "jsCode": "const domains=String($('Settings').first().json.vendor_domains || '').split(/[,;\\s]+/).map(x=>x.trim().toLowerCase()).filter(Boolean); if(!domains.length || domains.length>50) throw new Error('Supply1–50domains'); return [...new Set(domains)].map(domain=>({json:{domain}}));"
      }
