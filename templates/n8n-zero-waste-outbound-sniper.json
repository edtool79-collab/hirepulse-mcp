      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => { const wrapped=item.json; const status=Number(wrapped.statusCode ?? 200); const body=wrapped.body ?? wrapped; if(status>=400 || (body && typeof body.status==='number' && body.status>=400)) throw new Error('HirePulse HTTP '+status+': '+(body.code || body.detail || 'Request failed')+'. Stop here; review quota, input or x402 payment requirements. No payment was signed by this workflow.'); return {json:body}; });"
