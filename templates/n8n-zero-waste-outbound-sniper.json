    {
      "id": "1708c992-093a-5448-9f60-f159905874a9",
      "name": "Select Active Buyers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "const intents=new Map($('Hiring Intent - Check response').all().map(x=>[x.json.domain,x.json])); const threshold=Number($('Settings').first().json.min_intent_score ??30);return $input.all().flatMap(x=>{const ads=x.json;const intent=intents.get(ads.domain)||{};const jobs=Number(intent.total_open_roles||0);const active=Number(ads.ads_returned||0);if(jobs>0||active>0||Number(intent.intent_score||0)>=threshold)return [{json:{domain:ads.domain,intent,ads}}];return [];});"
      }
    },
