        0,
        300
      ],
      "parameters": {
        "content": "Screen each candidate with hiring intent and Google Ads; enrich only selected companies. List price:$0.02 per screened company +$0.015 per selected company when all four calls have data. Discarded companies can still incur screening costs. No verified competitor-cost savings or lead conversion rate is promised. Optional batch/hot-buyers quotes are separate flows, with paid redemption and3daily scans/IP.\nManual trigger only. Sandbox defaults cost $0; real inputs use quota or x402. No wallet signing, checkout or outreach. HTTP errors halt the workflow. Review inputs before running.",
        "height": 300,
        "width": 1100
      }
    },
