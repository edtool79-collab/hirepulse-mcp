        "jsCode": "const readiness=new Map($('Store Readiness - Check response').all().map(x=>[x.json.domain,x.json]));const leads=new Map($('Conversion Evidence - Check response').all().map(x=>[x.json.domain,x.json]));return $input.all().map(x=>({json:{domain:x.json.domain,readiness:readiness.get(x.json.domain),lead_evidence:leads.get(x.json.domain),comparison:x.json,note:'Evidence only; unknown is not false, and no fixes or outreach were executed.'}}));"
