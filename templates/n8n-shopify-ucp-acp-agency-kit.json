      "name": "Split Domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "const domains=String($('Settings').first().json.store_domains || '').split(/[,;\\s]+/).map(x=>x.trim().toLowerCase()).filter(Boolean); if(!domains.length || domains.length>50) throw new Error('Supply1–50domains'); return [...new Set(domains)].map(domain=>({json:{domain}}));"
      }
    },
